{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "salon-backend": {
      "root": "salon-backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "salon-frontend": {
      "root": "salon-frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "salon-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "salon-frontend"
      }
    }
  ]
}
